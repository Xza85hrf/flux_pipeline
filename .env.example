# FluxPipeline Environment Configuration
# Copy this file to .env and adjust values as needed
# Note: .env is gitignored and will not be committed

# ============================================================================
# GPU Configuration
# ============================================================================

# Specify which GPU devices to use (comma-separated)
# Example: "0" for first GPU, "0,1" for first two GPUs
CUDA_VISIBLE_DEVICES=0

# PyTorch CUDA memory allocation configuration
# Helps prevent fragmentation for large models
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Intel OpenMP duplicate library configuration
# Set to TRUE if you encounter OpenMP library conflicts
KMP_DUPLICATE_LIB_OK=TRUE

# ============================================================================
# Model Configuration
# ============================================================================

# Hugging Face model cache directory
# Where downloaded models will be stored
# HF_HOME=/path/to/model/cache
# TRANSFORMERS_CACHE=/path/to/model/cache

# Model ID for FLUX.1-schnell (default: black-forest-labs/FLUX.1-schnell)
# MODEL_ID=black-forest-labs/FLUX.1-schnell

# Enable offline mode (skip downloading, use cached models only)
# TRANSFORMERS_OFFLINE=1

# ============================================================================
# Application Configuration
# ============================================================================

# Workspace directory for generated images and outputs
WORKSPACE_DIR=./workspace

# Output directory (alternative to workspace)
# OUTPUT_DIR=./output

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=flux_pipeline.log

# ============================================================================
# Memory Management
# ============================================================================

# Memory threshold (0.0 to 1.0) - triggers cleanup when exceeded
MEMORY_THRESHOLD=0.90

# Maximum retry attempts for model operations
MAX_RETRIES=3

# Enable xformers memory-efficient attention (true/false)
ENABLE_XFORMERS=false

# ============================================================================
# Gradio Web Interface
# ============================================================================

# Port for Gradio web interface
GRADIO_PORT=7860

# Host address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
GRADIO_HOST=0.0.0.0

# Enable public sharing via Gradio share link (true/false)
GRADIO_SHARE=false

# Server name for Gradio
# GRADIO_SERVER_NAME=localhost

# ============================================================================
# Generation Defaults
# ============================================================================

# Default number of inference steps (1-4 recommended for FLUX.1-schnell)
DEFAULT_STEPS=4

# Default guidance scale (0.0 recommended for FLUX.1-schnell)
DEFAULT_GUIDANCE_SCALE=0.0

# Default image dimensions
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024

# Default batch size
DEFAULT_BATCH_SIZE=1

# ============================================================================
# Advanced Settings
# ============================================================================

# Enable safety checker (true/false)
# ENABLE_SAFETY_CHECKER=false

# Number of worker threads
# NUM_WORKERS=4

# Enable gradient checkpointing to save memory (true/false)
# GRADIENT_CHECKPOINTING=false

# Mixed precision training/inference (no/fp16/bf16)
# MIXED_PRECISION=fp16

# ============================================================================
# Development & Debugging
# ============================================================================

# Enable debug mode (more verbose logging)
# DEBUG=false

# Enable profiling
# ENABLE_PROFILING=false

# Disable progress bars
# DISABLE_TQDM=false

# Python warnings filter (default/ignore/error)
# PYTHONWARNINGS=default

# ============================================================================
# Security & Privacy
# ============================================================================

# Hugging Face API token (for private models or increased rate limits)
# HF_TOKEN=your_token_here

# Disable telemetry/analytics (if applicable)
# DISABLE_TELEMETRY=true

# ============================================================================
# Docker Specific (when running in container)
# ============================================================================

# Protocol buffers implementation
# PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Unbuffered Python output (for Docker logs)
# PYTHONUNBUFFERED=1
